# Station Controller - logging configuration
#
# Changes take effect on the next application restart.
#
# Log levels (least to most verbose):
#   CRITICAL  fatal errors only
#   ERROR     recoverable errors
#   WARNING   unexpected conditions (default file level)
#   INFO      normal operational events (default console level)
#   DEBUG     full detail - every command, poll, packet
#
# Typical workflow:
#   Development     - console: INFO,    file: WARNING
#   Production      - console: WARNING, file: WARNING
#   Troubleshooting - console: DEBUG,   file: DEBUG   (then restart)
#   Post-incident   - open logs/station.log
#
# The LOG_LEVEL environment variable overrides console_level without editing
# this file - useful for production deployments:
#   Windows:  $env:LOG_LEVEL = "WARNING"; python main.py
#   Linux:    LOG_LEVEL=WARNING python main.py

logging:
  # What gets printed to stdout / the terminal.
  # Set to WARNING or ERROR for production (or use the LOG_LEVEL env var).
  console_level: INFO

  file:
    enabled: true

    # Path to the log file.  Relative paths are resolved from the
    # application root directory (where main.py lives).
    path: logs/station.log

    # Minimum level written to file.
    # CRITICAL is always captured regardless of this setting.
    # Lower to DEBUG for full troubleshooting detail, then restart.
    level: WARNING

    # Rotation: each file grows to max_bytes before rolling over.
    max_bytes: 10485760   # 10 MB per file
    backup_count: 5       # keep station.log + 5 rotated files
