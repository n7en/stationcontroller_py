# Stream Deck configuration
#
# Requires:  pip install streamdeck Pillow
#
# The manager auto-detects whichever Stream Deck is plugged in (Mini, Standard, XL).
# Buttons are addressed by zero-based index, left-to-right, top-to-bottom.
#
# Standard (5x3):   0-14   Mini (3x2): 0-5   XL (8x4): 0-31
#
# Button types:
#   relay_toggle  -- press to toggle a DCN relay; LED shows ON/OFF live
#   coax_select   -- press to select a coax switch port; highlights when active
#   radio_tune    -- press to tune the radio to a preset frequency and mode
#
# sensor_key is the hardware key in the sensor registry (check /api/sensors).
# device_addr and bus must match the device's config in comms_config.yaml.

streamdeck:
  enabled: true
  brightness: 70          # 0-100

  buttons:

    # -- Relay toggles -------------------------------------------------------
    - index: 0
      type: relay_toggle
      label: "Ant A"
      sensor_key: "gpio_relay_0"    # key from /api/sensors
      device_addr: "01"
      bus: "control"
      relay_num: 0                  # 0-based relay number on the device

    - index: 1
      type: relay_toggle
      label: "Ant B"
      sensor_key: "gpio_relay_1"
      device_addr: "01"
      bus: "control"
      relay_num: 1

    # -- Coax port selectors -------------------------------------------------
    - index: 5
      type: coax_select
      label: "HF Coax"
      sensor_key: "coax_active_port"   # active port sensor from the coax switch
      device_addr: "02"
      bus: "control"
      port: 0                          # 0-based port index

    - index: 6
      type: coax_select
      label: "HF Coax"
      sensor_key: "coax_active_port"
      device_addr: "02"
      bus: "control"
      port: 1

    - index: 7
      type: coax_select
      label: "HF Coax"
      sensor_key: "coax_active_port"
      device_addr: "02"
      bus: "control"
      port: 2

    - index: 8
      type: coax_select
      label: "HF Coax"
      sensor_key: "coax_active_port"
      device_addr: "02"
      bus: "control"
      port: 3

    # -- Radio frequency presets ---------------------------------------------
    - index: 10
      type: radio_tune
      label: "40m SSB"
      frequency_hz: 7200000
      mode: "USB"
      radio_name: ""                   # leave blank to use primary radio

    - index: 11
      type: radio_tune
      label: "20m SSB"
      frequency_hz: 14225000
      mode: "USB"
      radio_name: ""

    - index: 12
      type: radio_tune
      label: "15m SSB"
      frequency_hz: 21300000
      mode: "USB"
      radio_name: ""

    - index: 13
      type: radio_tune
      label: "10m SSB"
      frequency_hz: 28500000
      mode: "USB"
      radio_name: ""
