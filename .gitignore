# Rename the .example files and edit them on each deployment.
config/radio_config.yaml
config/comms_config.yaml
config/logging_config.yaml
config/labels.yaml
config/dashboards/main.yaml
simulator/sim_config.yaml

# Log files
*.log
logs/

