[
    {
        "id": "dcn-mqtt-tab",
        "type": "tab",
        "label": "DCN MQTT Bridge",
        "disabled": false,
        "info": "Sierra Radio Systems — DCN ↔ MQTT Bridge\n\nBridges the DCN RS-485 serial bus to MQTT topics so the Python\nStation Controller application can communicate with the DCN.\n\nSetup:\n1. Double-click the 'DCN Serial Port' config node and set the correct\n   serial port and baud rate for your hardware.\n2. Double-click the 'Local MQTT Broker' config node and set the broker\n   address / credentials to match your comms_config.yaml.\n3. If you changed the topic names in comms_config.yaml, update the\n   MQTT In and MQTT Out nodes to match.\n4. Deploy.\n\nData flow:\n  RS-485 serial IN  → validate → MQTT publish  → dcn/control/rx\n  dcn/control/tx    → MQTT subscribe → RS-485 serial OUT"
    },
    {
        "id": "dcn-serial-config",
        "type": "serial-port",
        "serialport": "/dev/ttyUSB0",
        "serialbaud": "9600",
        "databits": "8",
        "parity": "none",
        "stopbits": "1",
        "waitfor": "",
        "newline": "\\r",
        "bin": "false",
        "out": "char",
        "addchar": "",
        "responsetimeout": 10000
    },
    {
        "id": "dcn-mqtt-broker",
        "type": "mqtt-broker",
        "name": "Local MQTT Broker",
        "broker": "localhost",
        "port": "1883",
        "clientid": "dcn-bridge",
        "autoConnect": true,
        "usetls": false,
        "protocolVersion": "4",
        "keepalive": "60",
        "cleansession": true,
        "autoUnsubscribe": true,
        "birthTopic": "",
        "birthQos": "0",
        "birthRetain": "false",
        "birthPayload": "",
        "closeTopic": "",
        "closeQos": "0",
        "closeRetain": "false",
        "closePayload": "",
        "willTopic": "",
        "willQos": "0",
        "willRetain": "false",
        "willPayload": ""
    },
    {
        "id": "dcn-serial-in",
        "type": "serial in",
        "name": "DCN Serial In",
        "serial": "dcn-serial-config",
        "x": 140,
        "y": 140,
        "z": "dcn-mqtt-tab",
        "wires": [["dcn-validate-rx"]]
    },
    {
        "id": "dcn-validate-rx",
        "type": "function",
        "name": "Validate DCN Packet",
        "func": "// Only forward strings that look like DCN packets (start with /)\nvar raw;\nif (Buffer.isBuffer(msg.payload)) {\n    raw = msg.payload.toString('ascii').trim();\n} else {\n    raw = String(msg.payload).trim();\n}\nif (raw.startsWith('/')) {\n    msg.payload = raw;\n    return msg;\n}\nreturn null;",
        "outputs": 1,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 370,
        "y": 140,
        "z": "dcn-mqtt-tab",
        "wires": [["dcn-mqtt-out"]]
    },
    {
        "id": "dcn-mqtt-out",
        "type": "mqtt out",
        "name": "Publish DCN RX",
        "topic": "dcn/control/rx",
        "qos": "0",
        "retain": "false",
        "respTopic": "",
        "contentType": "",
        "userProps": "",
        "correl": "",
        "expiry": "",
        "broker": "dcn-mqtt-broker",
        "x": 610,
        "y": 140,
        "z": "dcn-mqtt-tab",
        "wires": []
    },
    {
        "id": "dcn-mqtt-in",
        "type": "mqtt in",
        "name": "Subscribe DCN TX",
        "topic": "dcn/control/tx",
        "qos": "0",
        "datatype": "auto-detect",
        "broker": "dcn-mqtt-broker",
        "nl": false,
        "rap": true,
        "rh": 0,
        "inputs": 0,
        "x": 140,
        "y": 280,
        "z": "dcn-mqtt-tab",
        "wires": [["dcn-format-tx"]]
    },
    {
        "id": "dcn-format-tx",
        "type": "function",
        "name": "Ensure CR Terminator",
        "func": "// DCN packets must end with carriage return (ASCII 13)\nvar raw;\nif (Buffer.isBuffer(msg.payload)) {\n    raw = msg.payload.toString('ascii');\n} else {\n    raw = String(msg.payload);\n}\nraw = raw.trimEnd();\nif (!raw.endsWith('\\r')) {\n    raw = raw + '\\r';\n}\nmsg.payload = Buffer.from(raw, 'ascii');\nreturn msg;",
        "outputs": 1,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 370,
        "y": 280,
        "z": "dcn-mqtt-tab",
        "wires": [["dcn-serial-out"]]
    },
    {
        "id": "dcn-serial-out",
        "type": "serial out",
        "name": "DCN Serial Out",
        "serial": "dcn-serial-config",
        "x": 610,
        "y": 280,
        "z": "dcn-mqtt-tab",
        "wires": []
    },
    {
        "id": "dcn-comment-rx",
        "type": "comment",
        "name": "RX path — DCN serial → MQTT topic dcn/control/rx",
        "info": "",
        "x": 270,
        "y": 80,
        "z": "dcn-mqtt-tab",
        "wires": []
    },
    {
        "id": "dcn-comment-tx",
        "type": "comment",
        "name": "TX path — MQTT topic dcn/control/tx → DCN serial",
        "info": "",
        "x": 270,
        "y": 220,
        "z": "dcn-mqtt-tab",
        "wires": []
    }
]
